{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DynamicWorkflowModel",
  "description": "工作流模型规范",
  "type": "object",
  "properties": {
    "metadata": {
      "description": "工作流模型的基本信息",
      "type": "object",
      "properties": {
        "flowModelId": {
          "type": [ "integer", "null" ],
          "description": "工作流模型在数据库中的ID；新建模型尚未持久化时允许为null"
        },
        "flowModelName": { "type": "string", "description": "工作流模型名称" },
        "description": { "type": "string", "description": "工作流模型描述" }
      },
      "required": [ "flowModelId", "flowModelName" ]
    },
    "nodes": {
      "type": "array",
      "description": "工作流节点列表，每个节点是三种类型（DEV_NODE/FUNC_NODE/SUBFLOW_NODE）之一，通过nodeType字段区分",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/devNode" },
          { "$ref": "#/definitions/funcNode" },
          { "$ref": "#/definitions/subflowNode" }
        ]
      }
    },
    "interfaceConnections": {
      "type": "array",
      "description": "接口连接关系列表",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/Node2NodeConn" },
          { "$ref": "#/definitions/Node2DeviceConn" },
          { "$ref": "#/definitions/Device2NodeConn" }
        ]
      }
    },
    "portConnections": {
      "type": "array",
      "description": "端口连接关系列表",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string", "description": "连接说明" },
          "source": {
            "type": "object",
            "description": "数据来源端口，方向须为OUT",
            "properties": {
              "nodeName": { "type": "string", "description": "节点的name字段值" },
              "portName": { "type": "string", "description": "节点上的端口name字段值" }
            },
            "required": [ "nodeName", "portName" ]
          },
          "target": {
            "type": "object",
            "description": "数据目标端口，方向须为IN",
            "properties": {
              "nodeName": { "type": "string", "description": "节点的name字段值" },
              "portName": { "type": "string", "description": "节点上的端口name字段值" }
            },
            "required": [ "nodeName", "portName" ]
          }
        },
        "required": [ "source", "target" ]
      }
    }
  },
  "required": [ "metadata", "nodes", "interfaceConnections", "portConnections" ],
  "definitions": {
    "nodeIfRef": {
      "description": "节点接口引用，标识某个节点上的某个接口，作为接口连接的端点",
      "type": "object",
      "properties": {
        "nodeName": { "type": "string", "description": "目标节点的name字段值" },
        "interfaceName": { "type": "string", "description": "目标节点上的接口name字段值" }
      },
      "required": [ "nodeName", "interfaceName" ]
    },
    "deviceIfRef": {
      "description": "设备状态机接口引用，标识某个设备模型状态机上的某个接口；任务执行时由TASK.resource_map将DEV_NODE绑定到具体设备实例",
      "type": "object",
      "properties": {
        "deviceModelId": { "type": "integer", "description": "设备模型在数据库中的ID，须与相连DEV_NODE.deviceModelId一致" },
        "interfaceName": { "type": "string", "description": "设备状态机上的接口name字段值" }
      },
      "required": [ "deviceModelId", "interfaceName" ]
    },
    "Node2NodeConn": {
      "description": "节点→节点的接口连接，用于同一工作流内节点间的信号路由",
      "type": "object",
      "properties": {
        "description": { "type": "string", "description": "连接说明" },
        "connectionType": { "type": "string", "const": "NODE_TO_NODE" },
        "source": { "$ref": "#/definitions/nodeIfRef", "description": "发出信号的节点接口（WORKFLOW类型，OUT方向）" },
        "target": { "$ref": "#/definitions/nodeIfRef", "description": "接收信号的节点接口（WORKFLOW类型，IN方向）" }
      },
      "required": [ "connectionType", "source", "target" ]
    },
    "Node2DeviceConn": {
      "description": "节点→设备状态机的接口连接，节点向设备发送控制信号",
      "type": "object",
      "properties": {
        "description": { "type": "string", "description": "连接说明" },
        "connectionType": { "type": "string", "const": "NODE_TO_DEVICE" },
        "source": { "$ref": "#/definitions/nodeIfRef", "description": "发出控制信号的节点接口（STATE类型，OUT方向）" },
        "target": { "$ref": "#/definitions/deviceIfRef", "description": "接收控制信号的设备状态机接口" }
      },
      "required": [ "connectionType", "source", "target" ]
    },
    "Device2NodeConn": {
      "description": "设备状态机→节点的接口连接，设备向节点推送状态变化信号",
      "type": "object",
      "properties": {
        "description": { "type": "string", "description": "连接说明" },
        "connectionType": { "type": "string", "const": "DEVICE_TO_NODE" },
        "source": { "$ref": "#/definitions/deviceIfRef", "description": "推送状态信号的设备状态机接口" },
        "target": { "$ref": "#/definitions/nodeIfRef", "description": "接收状态信号的节点接口（STATE类型，IN方向）" }
      },
      "required": [ "connectionType", "source", "target" ]
    },
    "baseNode": {
      "description": "所有节点类型的公共字段",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "节点标识名，在同一工作流模型内唯一" },
        "internalVariables": {
          "type": "array",
          "description": "节点内部变量空间，生命周期内持久存在的状态量，可通过attributesMapping与设备属性同步，也可作为纯节点内部量供端口或触发器引用",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "变量标识名，在同一节点内唯一；可作为trigger.condition.object的引用目标" },
              "dataType": { "$ref": "协议规范.json#/definitions/DataType" },
              "initialValue": { "description": "内部变量初始值（可选）；类型须与dataType一致，创建TASK_STEP时写入变量空间，任务变量中已有同名值时不覆盖" },
              "attributesMapping": { "type": "string", "description": "映射的设备属性名（可选）；填写后运行时自动从设备属性同步值仅对DEV_NODE的变量有意义，关联DeviceModel的属性定义" }
            },
            "required": [ "name", "dataType" ]
          }
        },
        "lifecycle": {
          "type": "object",
          "description": "节点生命周期状态机，定义节点在运行期间经历的状态及合法转移路径",
          "properties": {
            "initialStateName": { "$ref": "系统执行规范.json#/definitions/NodeLifecycleState", "description": "节点启动时进入的初始状态，通常为PENDING" },
            "states": {
              "type": "array",
              "description": "此节点使用的生命周期状态子集",
              "items": { "$ref": "系统执行规范.json#/definitions/NodeLifecycleState" }
            },
            "transitions": {
              "type": "array",
              "description": "合法的状态转移规则列表，只有在此列表中声明的转移才允许发生",
              "items": {
                "type": "object",
                "properties": {
                  "description": { "type": "string", "description": "转移说明" },
                  "fromStateName": { "type": "string", "description": "原状态，states中的某个值" },
                  "toStateName": { "type": "string", "description": "目标状态，states中的某个值" }
                },
                "required": [ "fromStateName", "toStateName" ]
              }
            }
          },
          "required": [ "initialStateName", "states", "transitions" ]
        },
        "interfaces": {
          "type": "array",
          "description": "节点接口集合，节点对外暴露的信号通道",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "接口标识名，在同一节点内唯一；可作trigger.condition.object的引用目标，以及nodeIfRef.interfaceName的引用键" },
              "direction": {
                "type": "string",
                "enum": [ "IN", "OUT" ]
              },
              "interfaceType": {
                "type": "string",
                "enum": [ "WORKFLOW", "STATE" ]
              },
              "allowedSignals": {
                "type": "array",
                "description": "允许通过此接口的信号列表；WORKFLOW类型接口信号须符合协议规范.json中WorkflowNodeSignal定义，DEV_NODE的STATE类型OUT接口须符合WorkflowControlSignal，STATE类型IN接口仅接收CMD_STATE",
                "items": { "type": "string" }
              },
              "bindingTriggers": {
                "type": "array",
                "description": "绑定到此接口的触发器列表，各触发器独立求值，互不干扰；每个接口至少配置一个触发器，空列表在编译与前端检测中视为未完成配置。系统模板可先给出空数组，由建模者补全后再发布",
                "items": {
                  "type": "object",
                  "description": "引擎轮询评估condition；条件整体首次由false变为true时按顺序执行actions[]，若未写actions则执行action。动作立即持久化，但UPDATE造成的生命周期与内部变量变化不写回本轮求值快照，其他触发器下一轮才观察；同一触发器的actions[]仍按数组顺序立刻执行",
                  "properties": {
                    "condition": {
                      "type": "object",
                      "description": "触发条件；可使用单个判断条件，也可使用AND组合条件",
                      "oneOf": [
                        {
                          "type": "object",
                          "description": "单个判断条件",
                          "properties": {
                            "object": { "type": "string", "description": "被观测目标的标识名，包括节点内部变量名、nodeLifecycleState、taskLifecycleState、IN接口的signalName或系统预置触发器使用的payload.stateName" },
                            "operator": { "$ref": "系统执行规范.json#/definitions/ConstraintOperator" },
                            "threshold": {
                              "type": [ "number", "string", "boolean", "array" ],
                              "description": "比较阈值，类型须与object对应的数据类型兼容" }
                            },
                            "required": [ "object", "operator", "threshold" ]
                          },
                          {
                            "type": "object",
                            "description": "AND组合条件；所有conditions同时满足时，整个condition结果为true",
                            "properties": {
                            "logic": { "type": "string", "const": "AND", "description": "条件组合方式，当前只支持AND" },
                            "conditions": {
                              "type": "array",
                              "description": "参与AND判断的条件列表，所有条件基于本轮同一份节点快照求值",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "object": { "type": "string", "description": "被观测目标的标识名，包括节点内部变量名、nodeLifecycleState、taskLifecycleState、IN接口的signalName或系统预置触发器使用的payload.stateName" },
                                  "operator": { "$ref": "系统执行规范.json#/definitions/ConstraintOperator" },
                                  "threshold": {
                                    "type": [ "number", "string", "boolean", "array" ],
                                    "description": "比较阈值，类型须与object对应的数据类型兼容"
                                  }
                                },
                                "required": [ "object", "operator", "threshold" ]
                              }
                            }
                          },
                          "required": [ "logic", "conditions" ]
                        }
                      ]
                    },
                    "action": {
                      "description": "兼容字段，等于actions[0]；格式遵循WorkflowNodeAction，actionName必须包含在所属节点actions[]中",
                      "allOf": [
                        {
                          "$ref": "#/definitions/WorkflowNodeAction"
                        }
                      ]
                    },
                    "actions": {
                      "type": "array",
                      "minItems": 1,
                      "description": "同一上升沿按顺序执行的内联动作列表；存在非空actions时引擎忽略单独的action字段作为执行源，但仍可保留action=actions[0]以便兼容",
                      "items": { "$ref": "#/definitions/WorkflowNodeAction" }
                    }
                  },
                  "required": [ "condition" ],
                  "anyOf": [
                    { "required": [ "action" ] },
                    { "required": [ "actions" ] }
                  ]
                }
              }
            },
            "required": [ "name", "direction", "interfaceType" ]
          }
        },
        "ports": {
          "type": "array",
          "description": "节点数据端口集合，端口读写即对绑定的internalVariable读写",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "端口标识名" },
              "direction": {
                "type": "string",
                "enum": [ "IN", "OUT" ],
                "description": "IN接收上游数据并写入绑定变量，OUT将绑定变量值输出给下游"
              },
              "internalVariableName": { "type": "string", "description": "此端口绑定的内部变量名，节点internalVariables中已声明的变量" }
            },
            "required": [ "name", "direction", "internalVariableName" ]
          }
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "description": "工作流节点固定可用动作名集合，由系统自动维护为UPDATE与EMIT；接口触发器内联动作的actionName必须包含在该集合中",
          "items": { "$ref": "#/definitions/WorkflowNodeAction/properties/actionName" }
        }
      },
      "required": [ "name", "interfaces", "ports", "actions" ]
    },
    "devNode": {
      "description": "设备能力节点",
      "allOf": [
        { "$ref": "#/definitions/baseNode" },
        {
          "type": "object",
          "properties": {
            "nodeType": { "type": "string", "const": "DEV_NODE" },
            "deviceModelId": {
              "type": [ "integer", "null" ],
              "description": "绑定的设备模型ID，模板预览阶段允许为null"
            },
            "capability": {
              "type": "object",
              "description": "引用设备能力模型中的某项具体能力",
              "properties": {
                "capabilityName": { "type": "string", "description": "能力名称，与设备能力模型中capabilities[].capabilityName完全一致" },
                "capabilityParameters": { "type": "object", "description": "能力参数，具体字段结构由设备能力模型定义" }
              },
              "required": [ "capabilityName" ]
            }
          },
          "required": [ "nodeType", "deviceModelId", "lifecycle", "capability" ]
        }
      ]
    },
    "funcNode": {
      "description": "功能节点，无生命周期",
      "allOf": [
        { "$ref": "#/definitions/baseNode" },
        {
          "type": "object",
          "properties": {
            "nodeType": { "type": "string", "const": "FUNC_NODE" },
            "functionType": {
              "type": "string",
              "enum": [ "START", "END", "BRANCH", "AGGREGATE" ],
              "description": "功能节点类型：START起始节点、END终止节点、BRANCH分支节点、AGGREGATE聚合节点"
            },
            "expression": { "type": "string", "description": "赋值计算表达式（可选，仅BRANCH、AGGREGATE使用），格式为目标内部变量 = 计算式；可引用节点internalVariables，并支持rate、delta、avg、max、min、abs实验室时序函数。计算结果写入目标内部变量后再进行本轮触发器判断" }
          },
          "required": [ "nodeType", "functionType" ]
        }
      ]
    },
    "subflowNode": {
      "description": "子流程节点",
      "allOf": [
        { "$ref": "#/definitions/baseNode" },
        {
          "type": "object",
          "properties": {
            "nodeType": { "type": "string", "const": "SUBFLOW_NODE" },
            "subFlowModelId": { "type": "integer", "description": "被引用的子流程的工作流模型ID" },
            "subFlowModelDescription": { "type": "string", "description": "被引用子流程模型的描述" }
          },
          "required": [ "nodeType", "subFlowModelId", "lifecycle" ]
        }
      ]
    },
    "WorkflowNodeAction": {
      "type": "object",
      "description": "工作流节点内联动作定义；actionName为EMIT时payload使用targetInterfaceName和signalName，actionName为UPDATE时payload使用updateType、targetName，并按更新类型选择value或valueExpression",
      "properties": {
        "actionName": {
          "type": "string",
          "enum": [ "EMIT", "UPDATE" ],
          "description": "动作标识名，EMIT：通过输出接口向外发送信号；UPDATE：更新节点属性"
        },
        "payload": {
          "type": "object",
          "properties": {
            "targetInterfaceName": { "type": "string", "description": "EMIT可选，目标OUT接口名，须为节点interfaces[].name" },
            "signalName": { "type": "string", "description": "EMIT可选，发送的信号名，须包含在目标接口allowedSignals中" },
            "updateType": { "type":"string", "enum": [ "INTERNAL_VARIABLE", "NODE_LIFECYCLE" ], "description": "UPDATE可选，更新的类型，INTERNAL_VARIABLE或者NODE_LIFECYCLE" },
            "targetName": { "type": "string", "description": "UPDATE可选，更新目标名，如果updateType为INTERNAL_VARIABLE则是内部变量名internalVariables[].name，如果updateType为NODE_LIFECYCLE则是更新后的节点生命周期状态（转变规则需要符合transitions）" },
            "valueExpression": { "type": "string", "description": "UPDATE可选，updateType为INTERNAL_VARIABLE的写入值表达式，可引用当前输入信号payload和节点internalVariables" },
            "value": { "description": "UPDATE可选；updateType为INTERNAL_VARIABLE且直接写入常量时使用。允许任意JSON值，后端根据targetName对应internalVariables[].dataType校验类型；不得与valueExpression同时存在" }
          }
        }
      },
      "required": [ "actionName", "payload" ]
    }
  }
}
