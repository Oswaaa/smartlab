{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceStateMachineModel",
  "description": "设备状态机模型规范",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "deviceModelId": {
          "type": [ "integer", "null" ],
          "description": "所属设备模型在数据库中的ID；新建模型预览时允许为null"
        }
      },
      "required": [ "deviceModelId" ]
    },
    "interfaces": {
      "type": "array",
      "description": "状态机接口声明列表接口是信号进出状态机的通道，interfaceType决定该接口对接的对象，allowedSignals限定哪些信号可以通过",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "接口名称" },
          "direction": {
            "type": "string",
            "enum": [ "IN", "OUT" ]
          },
          "interfaceType": {
            "type": "string",
            "enum": [ "WORKFLOW", "STATE", "ADAPTER", "CONTROL", "CONSTRAINT" ],
            "description": "接口类型WORKFLOW：对接工作流引擎；STATE：广播状态变化；ADAPTER：对接底层Adapter；CONTROL：对接人工控制台；CONSTRAINT：对接约束引擎"
          },
          "allowedSignals": {
            "type": "array",
            "description": "接口允许通过的信号列表ADAPTER类型IN接口：信号名为能力模型adapterContract.events中声明的eventName，遥测数据不经过此接口；WORKFLOW类型：信号须符合协议规范.json中WorkflowControlSignal定义；CONTROL类型：信号须符合ManualControlSignal定义；CONSTRAINT类型：信号须符合ConstraintControlSignal定义；ADAPTER类型OUT接口：信号须符合AdapterOutboundSignal定义；STATE类型：信号须符合StatusSignal定义",
            "items": { "type": "string" }
          }
        },
        "required": [ "name", "direction", "interfaceType", "allowedSignals" ]
      }
    },
    "opStateSpace": {
      "type": "object",
      "description": "设备业务功能状态（OP状态空间）；每个区域的运行时当前状态统一表示为状态名数组，具体数量与变化方式由regionType决定",
      "properties": {
        "regions": {
          "type": "array",
          "description": "业务功能状态分区；OPERATIONAL区域是互斥单状态区域，EXCEPTION区域是可同时激活多个异常状态的集合区域",
          "items": {
            "type": "object",
            "properties": {
              "regionName": { "type": "string", "description": "分区名" },
              "regionType": { "type": "string", "enum": ["OPERATIONAL", "EXCEPTION"], "description": "区域类型：OPERATIONAL为互斥单状态的功能业务区域；EXCEPTION为不经过普通状态转移、可同时激活多个状态的异常集合区域" },
              "initialStateName": { "type": "string", "description": "区域初始状态名；OPERATIONAL区域必须引用本区域states[].stateName，EXCEPTION区域必须为空字符串" },
              "states": {
                "type": "array",
                "description": "分区允许使用的状态定义列表；EXCEPTION区域中的每个状态都必须至少被一条设备内置约束violationStateName引用，状态由监测器直接激活",
                "items": {
                  "type": "object",
                  "properties": {
                    "stateName": { "type": "string", "description": "状态名称" },
                    "onEntry": {
                      "type": "array",
                      "items": { "$ref": "#/definitions/StateMachineAction" }
                    }
                  },
                  "required": [ "stateName" ]
                }
              }
            },
            "required": [ "regionName", "regionType", "initialStateName", "states" ]
          }
        }
      },
      "required": [ "regions" ]
    },
    "cmdLifecycleSpace": {
      "type": "object",
      "description": "设备指令执行生命周期（CMD状态空间）标准路径：IDLE→SENT→RUNNING→COMPLETED终止分支：SENT/RUNNING→ABORTING→ABORTED异常分支：RUNNING→FAILED",
      "properties": {
        "initialStateName": { "type": "string", "description": "初始状态，通常为IDLE" },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stateName": { "type": "string", "description": "状态名称" },
              "onEntry": {
                "type": "array",
                "items": { "$ref": "#/definitions/StateMachineAction" }
              }
            },
            "required": [ "stateName" ]
          }
        }
      },
      "required": [ "initialStateName", "states" ]
    },
    "transitions": {
      "type": "array",
      "description": "设备状态转移规则系统级固定转移（systemTransitions）已由系统执行规范预定义，此处只需声明设备特有的转移规则（如adapter事件触发的SENT→RUNNING、RUNNING→COMPLETED等）；OP转移只能引用regionType为OPERATIONAL的区域，EXCEPTION区域由状态机内置约束监测器直接维护活动状态集合，不声明普通转移",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "stateSpace": {
            "type": "string",
            "enum": [ "CMD", "OP" ],
            "description": "CMD：指令生命周期；OP：业务功能状态"
          },
          "regionName": { "type": "string", "description": "当stateSpace为OP时必填，引用regionType为OPERATIONAL的业务功能状态分区名" },
          "fromStateName": { "type": "string", "description": "原状态" },
          "toStateName": { "type": "string", "description": "目标状态" },
          "trigger": {
            "type": "object",
            "properties": {
              "interfaceName": { "type": "string", "description": "触发接口名" },
              "signalName": { "type": "string", "description": "触发信号名，须包含在interfaceName所指接口的allowedSignals中" }
            },
            "required": [ "interfaceName", "signalName" ]
          },
          "actions": {
            "type": "array",
            "items": { "$ref": "#/definitions/StateMachineAction" }
          }
        },
        "required": [ "stateSpace", "fromStateName", "toStateName", "trigger" ]
      }
    }
  },
  "required": [ "metadata", "interfaces", "opStateSpace", "cmdLifecycleSpace", "transitions" ],
  "definitions": {
    "StateMachineAction": {
      "type": "object",
      "description": "状态机动作，在状态onEntry或转移时执行目前系统支持SEND动作（向指定输出接口发送信号）",
      "properties": {
        "actionName": {
          "type": "string",
          "enum": [ "SEND" ],
          "description": "动作类型名SEND：向指定输出接口发送信号"
        },
        "payload": {
          "type": "object",
          "properties": {
            "interfaceName": { "type": "string", "description": "目标接口名，须为OUT方向的接口" },
            "signalName": { "type": "string", "description": "发送的信号名，须包含在目标接口的allowedSignals中" }
          },
          "required": [ "interfaceName", "signalName" ]
        }
      },
      "required": [ "actionName", "payload" ]
    }
  }
}
