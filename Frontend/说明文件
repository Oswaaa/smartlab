my-vue-app/
├── node_modules/    # 依赖包
├── src/
│   ├── App.vue      # Vue 根组件（核心）
│   ├── main.js      # 入口文件：创建 Vue 实例并挂载
│   ├── components/  # 组件目录
│   └── style.css    # 全局样式
├── index.html       # Vite 入口（区别于 Webpack，Vite 以 HTML 为入口）
├── package.json     # 脚本和依赖（含 Vite、Vue 核心依赖）
└── vite.config.js   # Vite 配置文件（可选，自定义端口、插件等）
