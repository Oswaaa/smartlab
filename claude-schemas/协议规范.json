{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "协议规范.json",
  "title": "ProtocolSpec",
  "description": "协议规范，只承担跨引擎协议：系统信号定义、信号payload策略、MQTT主题约定与Adapter报文格式",
  "definitions": {
    "DataType": {
      "type": "string",
      "enum": [ "INTEGER", "DOUBLE", "STRING", "BOOLEAN", "JSON" ],
      "description": "全局标准数据类型，用于Adapter契约与遥测数据的类型声明"
    },
    "CommunicationProtocol": {
      "type": "string",
      "enum": [ "MQTT" ],
      "description": "Adapter与系统之间使用的通信协议"
    },
    "WorkflowNodeSignal": {
      "type": "string",
      "enum": [ "ACTIVE" ],
      "description": "工作流节点间的激活信号上游节点通过WORKFLOW类型OUT接口发送ACTIVE，下游节点通过WORKFLOW类型IN接口接收ACTIVE"
    },
    "WorkflowControlSignal": {
      "type": "string",
      "enum": [ "WF_EXECUTE_START", "WF_EXECUTE_ABORT" ],
      "description": "工作流引擎到状态机的控制信号WF_EXECUTE_START携带commandName与parameters；WF_EXECUTE_ABORT不携带业务载荷"
    },
    "ManualControlSignal": {
      "type": "string",
      "enum": [ "MANUAL_EXECUTE_START", "MANUAL_EXECUTE_ABORT" ],
      "description": "人工控制台到状态机的控制信号MANUAL_EXECUTE_START携带commandName与parameters；MANUAL_EXECUTE_ABORT不携带业务载荷"
    },
    "ConstraintControlSignal": {
      "type": "string",
      "enum": [ "CONSTRAINT_EXECUTE", "CONSTRAINT_ABORT" ],
      "description": "约束引擎到状态机的控制信号CONSTRAINT_EXECUTE携带目标能力及参数；CONSTRAINT_ABORT不携带业务载荷，由路由上下文确定目标设备"
    },
    "AdapterOutboundSignal": {
      "type": "string",
      "enum": [ "CMD_START", "CMD_ABORT" ],
      "description": "状态机到Adapter的标准下行信号CMD_START表示执行能力；CMD_ABORT表示状态机正在执行终止链路，状态机引擎据此查找isAbort为true的能力并构造命令报文"
    },
    "StatusSignal": {
      "type": "string",
      "enum": [ "CMD_STATE", "OP_STATE" ],
      "description": "状态机向系统总线广播的状态信号CMD_STATE的payload须符合CommandStatePayload；OP_STATE的payload须符合OperationStatePayload"
    },
    "SystemSignalFormat": {
      "type": "object",
      "description": "系统内部统一信号格式规范",
      "properties": {
        "signalName": { "type": "string", "description": "具体系统信号名，例如WF_EXECUTE_START、WF_EXECUTE_ABORT、MANUAL_EXECUTE_START、MANUAL_EXECUTE_ABORT、CONSTRAINT_EXECUTE、CONSTRAINT_ABORT、CMD_START、CMD_ABORT、CMD_STATE或OP_STATE" },
        "payload": { "type": "object", "additionalProperties": true, "description": "可选信号数据WF_EXECUTE_START和MANUAL_EXECUTE_START携带commandName与parameters；CONSTRAINT_EXECUTE携带ConstraintExecutePayload；CMD_STATE和OP_STATE分别携带对应状态payload；ABORT不携带业务载荷" }
      },
      "required": [ "signalName" ]
    },
    "MqttTopicConvention": {
      "type": "object",
      "description": "MQTT主题命名规范",
      "properties": {
        "registerTopic": { "const": "smartlab/adapter/register", "description": "系统订阅，adapter发布：adapter注册" },
        "heartbeatTopic": { "const": "smartlab/adapter/{adapterName}/heartbeat", "description": "系统订阅，adapter发布：心跳检测" },
        "commandTopic": { "const": "smartlab/adapter/{adapterName}/{devicePoint}/command", "description": "系统发布，adapter订阅：系统下发指令" },
        "telemetryTopic": { "const": "smartlab/adapter/{adapterName}/{devicePoint}/telemetry", "description": "系统订阅，adapter发布：上报遥测数据" },
        "eventTopic": { "const": "smartlab/adapter/{adapterName}/{devicePoint}/event", "description": "系统订阅，adapter发布：上报事件" }
      },
      "required": [ "registerTopic", "heartbeatTopic", "commandTopic", "telemetryTopic", "eventTopic" ]
    },
    "AdapterRegisterRequest": {
      "type": "object",
      "description": "registerTopic消息格式规范",
      "properties": {
        "adapterName": { "type": "string", "description": "adapter标识名，全局唯一" },
        "rawConfigFormat": {
          "type": "string",
          "enum": [ "INI", "JSON" ],
          "default": "INI"
        },
        "rawConfigContent": { "type": "string", "description": "完整的adapter原始配置信息" },
        "timestamp": { "type": "integer" }
      },
      "required": [ "adapterName", "rawConfigFormat", "rawConfigContent", "timestamp" ]
    },
    "CommandMessageFormat": {
      "type": "object",
      "description": "commandTopic消息格式规范状态机引擎根据状态转移决定执行能力或isAbort为true的终止能力，并统一按本报文发送；不使用operation字段区分",
      "properties": {
        "messageId": { "type": "string", "description": "唯一消息ID" },
        "adapterName": { "type": "string", "description": "adapter标识名" },
        "devicePoint": { "type": "string", "description": "设备点" },
        "commandName": { "type": "string", "description": "Adapter实际执行的能力映射命令名；终止时为isAbort为true的能力对应adapterCommandName" },
        "parameters": { "type": "object", "description": "指令参数键值对；终止能力无参数时发送空对象" },
        "timestamp": { "type": "integer" }
      },
      "required": [ "messageId", "adapterName", "devicePoint", "commandName", "parameters", "timestamp" ]
    },
    "TelemetryMessageFormat": {
      "type": "object",
      "description": "telemetryTopic消息格式规范",
      "properties": {
        "timestamp": { "type": "integer" },
        "adapterName": { "type": "string", "description": "adapter标识名" },
        "devicePoint": { "type": "string", "description": "设备点" },
        "telemetryData": { "type": "object", "description": "属性键值对" }
      },
      "required": [ "timestamp", "adapterName", "devicePoint", "telemetryData" ]
    },
    "EventMessageFormat": {
      "type": "object",
      "description": "eventTopic消息格式规范",
      "properties": {
        "timestamp": { "type": "integer" },
        "messageId": { "type": "string", "description": "指令生命周期事件必须回传对应command消息的messageId" },
        "adapterName": { "type": "string", "description": "adapter标识名" },
        "devicePoint": { "type": "string", "description": "设备点" },
        "eventName": { "type": "string", "description": "事件名称代号" },
        "payload": { "type": "object", "description": "（可选）事件携带的具体参数" }
      },
      "required": [ "timestamp", "adapterName", "devicePoint", "eventName" ]
    },
    "AdapterHeartbeat": {
      "type": "object",
      "description": "heartbeatTopic消息格式规范心跳只声明ALIVE；系统以超时判定Adapter离线",
      "properties": {
        "status": {
          "type": "string",
          "enum": [ "ALIVE" ]
        },
        "timestamp": { "type": "integer" }
      },
      "required": [ "status", "timestamp" ]
    },
    "ConstraintExecutePayload": {
      "type": "object",
      "description": "CONSTRAINT_EXECUTE的payload格式",
      "properties": {
        "deviceInstanceId": { "type": "integer", "description": "目标设备实例ID" },
        "capabilityName": { "type": "string", "description": "目标能力名，引用设备能力模型capabilities[].capabilityName" },
        "parameters": { "type": "object", "description": "能力参数，由目标设备能力定义" }
      },
      "required": [ "deviceInstanceId", "capabilityName", "parameters" ]
    },
    "CommandStatePayload": {
      "type": "object",
      "description": "CMD_STATE的payload格式，用于工作流引擎和约束引擎映射设备指令生命周期状态",
      "properties": {
        "deviceModelId": { "type": "integer", "description": "设备模型ID" },
        "deviceInstanceId": { "type": "integer", "description": "设备实例ID" },
        "messageId": {
          "type": [ "string", "null" ],
          "description": "关联指令消息ID；非指令关联状态允许为null"
        },
        "stateName": { "type": "string", "description": "CMD状态名，例如IDLE、SENT、RUNNING、COMPLETED、FAILED、ABORTING、ABORTED" },
        "timestamp": { "type": "integer", "description": "状态变化时间戳" }
      },
      "required": [ "deviceModelId", "deviceInstanceId", "messageId", "stateName", "timestamp" ]
    },
    "OperationStatePayload": {
      "type": "object",
      "description": "OP_STATE的payload格式，用于工作流引擎和约束引擎映射设备业务功能状态",
      "properties": {
        "deviceModelId": { "type": "integer", "description": "设备模型ID" },
        "deviceInstanceId": { "type": "integer", "description": "设备实例ID" },
        "regionName": { "type": "string", "description": "OP状态分区名，引用设备状态机模型opStateSpace.regions[].regionName" },
        "stateName": { "type": "string", "description": "该分区当前状态名" },
        "timestamp": { "type": "integer", "description": "状态变化时间戳" }
      },
      "required": [ "deviceModelId", "deviceInstanceId", "regionName", "stateName", "timestamp" ]
    }
  }
}
