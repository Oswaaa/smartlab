{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConstraintModel",
  "description": "需求约束模型规范",
  "type": "object",
  "properties": {
    "observableObjects": {
      "type": "array",
      "description": "可观测对象空间，约束引擎通过此列表声明需要监测的数据源，通过sourceType区分",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/deviceAttributeObservable" },
          { "$ref": "#/definitions/deviceOpStateObservable" },
          { "$ref": "#/definitions/deviceCmdLifecycleObservable" },
          { "$ref": "#/definitions/nodeLifecycleObservable" },
          { "$ref": "#/definitions/nodeInternalVarObservable" },
          { "$ref": "#/definitions/taskLifecycleObservable" }
        ]
      }
    },
    "constraints": {
      "type": "array",
      "description": "约束规则集",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "约束规则名" },
          "expression": { "type": "string", "description": "布尔表达式，结果为true时视为违规并执行violationActions支持运算符：算术（+,-,*,/）、比较（>,<,>=,<=,==,!=）、逻辑（&&,||,!）内置函数：delta(var,seconds) N秒内变化量；avg(var,seconds) N秒滚动均值；rate(var) 变化速率（单位/秒）表达式中的变量名须在bindings中声明示例：'a > 80'、'delta(a,60) > 5'、'avg(a,300) > b && state == RUNNING'" },
          "bindings": {
            "type": "object",
            "description": "表达式中变量名到数据源的纯映射，不含任何计算逻辑（计算逻辑写在expression中）key为表达式中的变量名，value为绑定目标",
            "additionalProperties": {
              "oneOf": [
                {
                  "description": "绑定到observableObjects中已声明的可观测对象",
                  "type": "object",
                  "properties": {
                    "bindingType": { "type": "string", "const": "OBSERVABLE" },
                    "observableName": { "type": "string", "description": "引用observableObjects中的name字段值" }
                  },
                  "required": [ "bindingType", "observableName" ]
                },
                {
                  "description": "绑定到字面量常量",
                  "type": "object",
                  "properties": {
                    "bindingType": { "type": "string", "const": "LITERAL" },
                    "value": {
                      "type": [ "number", "string", "boolean" ],
                      "description": "常量值，类型须与被比较的observable的dataType兼容"
                    }
                  },
                  "required": [ "bindingType", "value" ]
                }
              ]
            }
          },
          "windowSeconds": { "type": "integer", "description": "持续触发阈值（可选）：expression连续为true超过此秒数后才执行violationActions；不填则瞬时触发" },
          "violationActions": {
            "type": "array",
            "description": "违规处置动作列表，expression满足条件时执行",
            "items": {
              "oneOf": [
                { "$ref": "#/definitions/systemViolationAction" },
                { "$ref": "#/definitions/deviceCapabilityViolationAction" }
              ]
            }
          }
        },
        "required": [ "name", "expression", "bindings", "violationActions" ]
      }
    }
  },
  "required": [ "observableObjects", "constraints" ],
  "definitions": {
    "observableBase": {
      "description": "可观测对象的公共字段",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "可观测对象唯一标识名，在同一约束模型内唯一；被constraints[].bindings中的observableName引用" },
        "sourceType": {
          "type": "string",
          "enum": [ "DEVICE_ATTRIBUTE", "DEVICE_OPERATION_STATE", "DEVICE_COMMAND_LIFECYCLE", "NODE_LIFECYCLE_STATE", "NODE_INTERNAL_VARIABLE", "TASK_LIFECYCLE_STATE" ]
        },
        "dataType": { "$ref": "协议规范.json#/definitions/DataType", "description": "被观测数据的类型，用于约束引擎校验expression中threshold的类型兼容性" }
      },
      "required": [ "name", "sourceType", "dataType" ]
    },
    "deviceAttributeObservable": {
      "description": "DEVICE_ATTRIBUTE：监测某设备实例（或某模型所有实例）的属性值",
      "allOf": [
        { "$ref": "#/definitions/observableBase" },
        {
          "type": "object",
          "properties": {
            "sourceType": { "type": "string", "const": "DEVICE_ATTRIBUTE" },
            "deviceModelId": { "type": "integer", "description": "设备模型ID" },
            "deviceInstanceId": { "type": "integer", "description": "设备实例ID（可选）；不填则监控该模型所有实例" },
            "targetName": { "type": "string", "description": "被监测的属性名，与设备能力模型attributes[].attributeName完全一致" }
          },
          "required": [ "sourceType", "deviceModelId", "targetName" ]
        }
      ]
    },
    "deviceOpStateObservable": {
      "description": "DEVICE_OPERATION_STATE：监测某设备实例（或某模型所有实例）的业务功能状态",
      "allOf": [
        { "$ref": "#/definitions/observableBase" },
        {
          "type": "object",
          "properties": {
            "sourceType": { "type": "string", "const": "DEVICE_OPERATION_STATE" },
            "deviceModelId": { "type": "integer", "description": "设备模型ID" },
            "deviceInstanceId": { "type": "integer", "description": "设备实例ID（可选）；不填则监控该模型所有实例" },
            "regionName": { "type": "string", "description": "被监测的OP状态分区名，引用设备状态机模型opStateSpace.regions[].regionName" }
          },
          "required": [ "sourceType", "deviceModelId", "regionName" ]
        }
      ]
    },
    "deviceCmdLifecycleObservable": {
      "description": "DEVICE_COMMAND_LIFECYCLE：监测某设备实例（或某模型所有实例）的指令执行生命周期状态",
      "allOf": [
        { "$ref": "#/definitions/observableBase" },
        {
          "type": "object",
          "properties": {
            "sourceType": { "type": "string", "const": "DEVICE_COMMAND_LIFECYCLE" },
            "deviceModelId": { "type": "integer", "description": "设备模型ID" },
            "deviceInstanceId": { "type": "integer", "description": "设备实例ID（可选）；不填则监控该模型所有实例" }
          },
          "required": [ "sourceType", "deviceModelId" ]
        }
      ]
    },
    "nodeLifecycleObservable": {
      "description": "NODE_LIFECYCLE_STATE：监测工作流中某个节点的生命周期状态",
      "allOf": [
        { "$ref": "#/definitions/observableBase" },
        {
          "type": "object",
          "properties": {
            "sourceType": { "type": "string", "const": "NODE_LIFECYCLE_STATE" },
            "workflowTemplateId": { "type": "integer", "description": "目标工作流模型ID" },
            "nodeName": { "type": "string", "description": "目标节点的name字段值，须是DEV_NODE或SUBFLOW_NODE" }
          },
          "required": [ "sourceType", "workflowTemplateId", "nodeName" ]
        }
      ]
    },
    "nodeInternalVarObservable": {
      "description": "NODE_INTERNAL_VARIABLE：监测工作流节点内部变量空间中某个具体变量的值",
      "allOf": [
        { "$ref": "#/definitions/observableBase" },
        {
          "type": "object",
          "properties": {
            "sourceType": { "type": "string", "const": "NODE_INTERNAL_VARIABLE" },
            "workflowTemplateId": { "type": "integer", "description": "目标工作流模型ID" },
            "nodeName": { "type": "string", "description": "目标节点的name字段值" },
            "variableName": { "type": "string", "description": "被监测的内部变量名，须与该节点internalVariables[].name完全一致" }
          },
          "required": [ "sourceType", "workflowTemplateId", "nodeName", "variableName" ]
        }
      ]
    },
    "systemViolationAction": {
      "description": "SYSTEM：执行任务级处置动作或告警",
      "type": "object",
      "properties": {
        "actionType": { "type": "string", "const": "SYSTEM" },
        "action": {
          "type": "string",
          "enum": [ "ABORT", "PAUSE", "ALERT" ],
          "description": "ABORT：终止targetTaskId对应任务；PAUSE：暂停targetTaskId对应任务；ALERT：发送告警通知"
        },
        "targetTaskId": {
          "type": [ "integer", "null" ],
          "description": "目标任务实例IDABORT和PAUSE必须填写；ALERT允许为null"
        }
      },
      "required": [ "actionType", "action", "targetTaskId" ]
    },
    "deviceCapabilityViolationAction": {
      "description": "DEVICE_CAPABILITY：通过目标设备状态机执行指定能力；目标能力isAbort为true时转换为CONSTRAINT_ABORT，否则转换为CONSTRAINT_EXECUTE",
      "type": "object",
      "properties": {
        "actionType": { "type": "string", "const": "DEVICE_CAPABILITY" },
        "deviceInstanceId": { "type": "integer", "description": "目标设备实例ID" },
        "capabilityName": { "type": "string", "description": "引用设备能力模型capabilities[].capabilityName" },
        "parameters": { "type": "object", "description": "能力参数（可选），具体字段结构由设备能力模型定义" }
      },
      "required": [ "actionType", "deviceInstanceId", "capabilityName" ]
    },
    "taskLifecycleObservable": {
      "description": "TASK_LIFECYCLE_STATE：监测某个任务实例的整体执行状态，对应数据库TASK_STATUS",
      "allOf": [
        { "$ref": "#/definitions/observableBase" },
        {
          "type": "object",
          "properties": {
            "sourceType": { "type": "string", "const": "TASK_LIFECYCLE_STATE" },
            "taskId": { "type": "integer", "description": "目标任务实例ID" }
          },
          "required": [ "sourceType", "taskId" ]
        }
      ]
    }
  }
}
