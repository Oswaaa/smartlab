{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceCapabilityModel",
  "description": "设备能力模型规范",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "deviceModelId": {
          "type": [ "integer", "null" ],
          "description": "设备模型在数据库中的ID；新建模型预览时允许为null"
        },
        "deviceModelName": { "type": "string", "description": "设备模型名称" },
        "deviceCategoryId": {
          "type": [ "integer", "null" ],
          "description": "设备类别在数据库中的ID；尚未选择类别的预览允许为null"
        }
      },
      "required": [ "deviceModelId", "deviceModelName", "deviceCategoryId" ]
    },
    "attributes": {
      "type": "array",
      "description": "设备属性空间",
      "items": {
        "type": "object",
        "properties": {
          "attributeName": { "type": "string", "description": "属性唯一标识名" },
          "displayName": { "type": "string", "description": "前端UI渲染显示名" },
          "valueKind": {
            "type": "string",
            "enum": [ "DISCRETE", "CONTINUOUS" ]
          },
          "dataType": { "$ref": "协议规范.json#/definitions/DataType" },
          "unit": { "type": "string", "description": "物理单位" }
        },
        "required": [ "attributeName", "valueKind", "dataType" ]
      }
    },
    "capabilities": {
      "type": "array",
      "description": "设备对外暴露的操作能力",
      "items": {
        "type": "object",
        "properties": {
          "capabilityName": { "type": "string", "description": "操作能力唯一标识名" },
          "adapterCommandName": { "type": "string", "description": "映射并指向adapterContract.commands中的commandName" },
          "displayName": { "type": "string" },
          "isAbort": { "type": "boolean", "default": false, "description": "标记此能力是否为中止操作当状态机收到中止信号进入ABORTING时，引擎从capabilities中找到isAbort为true的条目，将其adapterCommandName作为中止指令发送给adapter" },
          "parameters": {
            "type": "array",
            "description": "capability对外暴露的操作参数列表",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "description": "参数标识名" },
                "displayName": { "type": "string", "description": "参数展示名" },
                "dataType": { "$ref": "协议规范.json#/definitions/DataType" }
              },
              "required": [ "name", "displayName", "dataType" ]
            }
          },
          "parameterMapping": {
            "type": "array",
            "description": "参数映射关系，将capability参数映射到adapter命令参数",
            "items": {
              "type": "object",
              "properties": {
                "commandParamName": { "type": "string", "description": "adapter命令的参数名" },
                "capabilityParamName": { "type": "string", "description": "capability的参数名" },
                "isFixedValue": { "type": "boolean", "default": false },
                "fixedValue": { "description": "固定参数的值，isFixedValue为true时必填" }
              },
              "required": [ "commandParamName", "isFixedValue" ]
            }
          }
        },
        "required": [ "capabilityName", "adapterCommandName", "displayName", "parameters", "parameterMapping" ]
      }
    },
    "adapterContract": {
      "type": "object",
      "description": "adapter适配契约",
      "properties": {
        "config": {
          "type": "object",
          "description": "Adapter通信配置",
          "properties": {
            "protocol": { "$ref": "协议规范.json#/definitions/CommunicationProtocol" },
            "adapterName": { "type": "string", "description": "Adapter标识名" },
            "categoryName": { "type": "string", "description": "Adapter侧类别名称" }
          },
          "required": [ "protocol", "adapterName", "categoryName" ]
        },
        "commands": {
          "type": "array",
          "description": "adapter支持的执行命令列表",
          "items": {
            "type": "object",
            "properties": {
              "commandName": { "type": "string", "description": "adapter命令唯一标识名" },
              "commandParameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "paramName": { "type": "string", "description": "adapter命令参数名" },
                    "dataType": { "$ref": "协议规范.json#/definitions/DataType" },
                    "description": { "type": "string" }
                  },
                  "required": [ "paramName", "dataType" ]
                }
              }
            },
            "required": [ "commandName", "commandParameters" ]
          }
        },
        "telemetry": {
          "type": "object",
          "description": "adapter遥测数据上报遥测数据由后端直接订阅telemetryTopic后入库，不经过状态机接口",
          "properties": {
            "adapterAttributes": {
              "type": "array",
              "description": "声明Adapter能够上报的属性字段列表",
              "items": {
                "type": "object",
                "properties": {
                  "telemetryName": { "type": "string", "description": "Adapter上报data中的字段名" },
                  "dataType": { "$ref": "协议规范.json#/definitions/DataType" },
                  "description": { "type": "string" }
                },
                "required": [ "telemetryName", "dataType" ]
              }
            },
            "attributesMapping": {
              "type": "array",
              "description": "将Adapter上报字段映射到设备属性",
              "items": {
                "type": "object",
                "properties": {
                  "adapterAttrName": { "type": "string", "description": "Adapter遥测字段名，引用adapterAttributes[].telemetryName" },
                  "modelAttributeName": { "type": "string", "description": "设备模型属性名，引用attributes[].attributeName" }
                },
                "required": [ "adapterAttrName", "modelAttributeName" ]
              }
            }
          },
          "required": [ "adapterAttributes", "attributesMapping" ]
        },
        "events": {
          "type": "object",
          "description": "adapter反馈事件事件由后端订阅eventTopic后路由到状态机Interface_adapter_in，驱动状态转移",
          "properties": {
            "cmdEvents": {
              "type": "array",
              "description": "adapter命令执行生命周期反馈事件（如已接收、已完成、已失败、已中止）",
              "items": {
                "type": "object",
                "properties": {
                  "eventName": { "type": "string", "description": "事件标识名" },
                  "description": { "type": "string", "description": "事件描述" }
                },
                "required": [ "eventName", "description" ]
              }
            },
            "opEvents": {
              "type": "array",
              "description": "adapter功能状态反馈事件（如温度到达目标值、设备进入特定运行状态）",
              "items": {
                "type": "object",
                "properties": {
                  "eventName": { "type": "string", "description": "事件标识名" },
                  "description": { "type": "string", "description": "事件描述" }
                },
                "required": [ "eventName", "description" ]
              }
            }
          },
          "required": [ "cmdEvents", "opEvents" ]
        }
      },
      "required": [ "config", "commands", "telemetry", "events" ]
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "portName": { "type": "string", "description": "端口标识名" },
          "direction": {
            "type": "string",
            "enum": [ "IN", "OUT" ]
          },
          "bindingAttrName": { "type": "string", "description": "绑定的设备模型属性名，引用attributes[].attributeName" }
        },
        "required": [ "portName", "direction", "bindingAttrName" ]
      }
    },
    "intrinsicConstraints": {
      "type": "array",
      "description": "设备内置约束，在运行期间由约束引擎持续检测",
      "items": {
        "type": "object",
        "properties": {
          "objectAttributeName": { "type": "string", "description": "被约束的设备模型属性名，引用attributes[].attributeName" },
          "operator": {
            "allOf": [
              { "$ref": "系统执行规范.json#/definitions/ConstraintOperator" },
              {
                "enum": [ ">", "<", ">=", "<=", "=", "!=" ]
              }
            ],
            "description": "约束比较操作符（剔除BETWEEN与IN，确保单值boundaryValue）"
          },
          "boundaryValue": { "type": "number", "description": "内置约束阈值" },
          "violationStateName": { "type": "string", "description": "对应状态机中的异常状态名" }
        },
        "required": [ "objectAttributeName", "operator", "boundaryValue", "violationStateName" ]
      }
    }
  },
  "required": [ "metadata", "attributes", "capabilities", "adapterContract", "ports", "intrinsicConstraints" ]
}
