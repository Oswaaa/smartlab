{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConstraintModel",
  "description": "需求约束模型规范",
  "type": "object",
  "properties": {
    "observableObjects": {
      "type": "array",
      "description": "可观测对象空间，约束引擎通过此列表声明需要监测的数据源。",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/deviceAttributeObservable"
          },
          {
            "$ref": "#/definitions/deviceOpStateObservable"
          },
          {
            "$ref": "#/definitions/deviceCmdLifecycleObservable"
          },
          {
            "$ref": "#/definitions/nodeLifecycleObservable"
          },
          {
            "$ref": "#/definitions/nodeInternalVarObservable"
          },
          {
            "$ref": "#/definitions/workflowLifecycleObservable"
          }
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "约束规则名"
          },
          "expression": {
            "type": "string",
            "description": "布尔表达式，结果为true时视为违规。表达式变量须在bindings中声明；函数语义由system-execution-spec.json的constraintEngine定义。"
          },
          "bindings": {
            "type": "object",
            "description": "表达式变量到数据源或字面量的映射。",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "bindingType": {
                      "const": "OBSERVABLE"
                    },
                    "observableName": {
                      "type": "string"
                    }
                  },
                  "required": [ "bindingType", "observableName" ]
                },
                {
                  "type": "object",
                  "properties": {
                    "bindingType": {
                      "const": "LITERAL"
                    },
                    "value": {
                      "type": [ "number", "string", "boolean" ]
                    }
                  },
                  "required": [ "bindingType", "value" ]
                }
              ]
            }
          },
          "windowSeconds": {
            "type": "integer",
            "description": "expression连续为true超过此秒数后执行violationActions；不填则瞬时触发。"
          },
          "violationActions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/definitions/systemViolationAction"
                },
                {
                  "$ref": "#/definitions/deviceCapabilityViolationAction"
                }
              ]
            }
          }
        },
        "required": [ "name", "expression", "bindings", "violationActions" ]
      }
    }
  },
  "required": [ "observableObjects", "constraints" ],
  "definitions": {
    "observableBase": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "可观测对象唯一标识名"
        },
        "sourceType": {
          "type": "string",
          "enum": [ "DEVICE_ATTRIBUTE", "DEVICE_OPERATION_STATE", "DEVICE_COMMAND_LIFECYCLE", "NODE_LIFECYCLE_STATE", "NODE_INTERNAL_VARIABLE", "WORKFLOW_LIFECYCLE_STATE" ]
        },
        "dataType": {
          "$ref": "protocol-spec.json#/definitions/DataType"
        }
      },
      "required": [ "name", "sourceType", "dataType" ]
    },
    "deviceAttributeObservable": {
      "allOf": [
        {
          "$ref": "#/definitions/observableBase"
        },
        {
          "type": "object",
          "properties": {
            "sourceType": {
              "const": "DEVICE_ATTRIBUTE"
            },
            "deviceModelId": {
              "type": "integer"
            },
            "deviceInstanceId": {
              "type": "integer"
            },
            "targetName": {
              "type": "string",
              "description": "引用DeviceCapabilityModel.attributes[].name"
            }
          },
          "required": [ "sourceType", "deviceModelId", "targetName" ]
        }
      ]
    },
    "deviceOpStateObservable": {
      "allOf": [
        {
          "$ref": "#/definitions/observableBase"
        },
        {
          "type": "object",
          "properties": {
            "sourceType": {
              "const": "DEVICE_OPERATION_STATE"
            },
            "deviceModelId": {
              "type": "integer"
            },
            "deviceInstanceId": {
              "type": "integer"
            }
          },
          "required": [ "sourceType", "deviceModelId" ]
        }
      ]
    },
    "deviceCmdLifecycleObservable": {
      "allOf": [
        {
          "$ref": "#/definitions/observableBase"
        },
        {
          "type": "object",
          "properties": {
            "sourceType": {
              "const": "DEVICE_COMMAND_LIFECYCLE"
            },
            "deviceModelId": {
              "type": "integer"
            },
            "deviceInstanceId": {
              "type": "integer"
            }
          },
          "required": [ "sourceType", "deviceModelId" ]
        }
      ]
    },
    "nodeLifecycleObservable": {
      "allOf": [
        {
          "$ref": "#/definitions/observableBase"
        },
        {
          "type": "object",
          "properties": {
            "sourceType": {
              "const": "NODE_LIFECYCLE_STATE"
            },
            "flowModelId": {
              "type": "integer",
              "description": "引用WorkflowModel.metadata.flowModelId"
            },
            "nodeName": {
              "type": "string"
            }
          },
          "required": [ "sourceType", "flowModelId", "nodeName" ]
        }
      ]
    },
    "nodeInternalVarObservable": {
      "allOf": [
        {
          "$ref": "#/definitions/observableBase"
        },
        {
          "type": "object",
          "properties": {
            "sourceType": {
              "const": "NODE_INTERNAL_VARIABLE"
            },
            "flowModelId": {
              "type": "integer",
              "description": "引用WorkflowModel.metadata.flowModelId"
            },
            "nodeName": {
              "type": "string"
            },
            "variableName": {
              "type": "string"
            }
          },
          "required": [ "sourceType", "flowModelId", "nodeName", "variableName" ]
        }
      ]
    },
    "workflowLifecycleObservable": {
      "allOf": [
        {
          "$ref": "#/definitions/observableBase"
        },
        {
          "type": "object",
          "properties": {
            "sourceType": {
              "const": "WORKFLOW_LIFECYCLE_STATE"
            },
            "flowModelId": {
              "type": "integer",
              "description": "引用WorkflowModel.metadata.flowModelId"
            }
          },
          "required": [ "sourceType", "flowModelId" ]
        }
      ]
    },
    "SystemViolationAction": {
      "type": "string",
      "enum": [ "ABORT", "PAUSE", "ALERT", "LOG_ONLY" ],
      "description": "约束违规处置动作，运行语义由system-execution-spec.json的constraintEngine定义。"
    },
    "systemViolationAction": {
      "type": "object",
      "properties": {
        "actionType": {
          "const": "SYSTEM"
        },
        "action": {
          "$ref": "#/definitions/SystemViolationAction"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [ "actionType", "action" ]
    },
    "deviceCapabilityViolationAction": {
      "type": "object",
      "properties": {
        "actionType": {
          "const": "DEVICE_CAPABILITY"
        },
        "deviceInstanceId": {
          "type": "integer"
        },
        "capabilityName": {
          "type": "string",
          "description": "引用DeviceCapabilityModel.capabilities[].capabilityName"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [ "actionType", "deviceInstanceId", "capabilityName" ]
    }
  }
}
