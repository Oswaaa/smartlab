{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceCapabilityModel",
  "description": "设备能力模型规范",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "deviceModelId": {
          "type": [ "integer", "null" ],
          "description": "设备模型在数据库中的ID；新建模型预览时允许为null"
        },
        "deviceModelName": {
          "type": "string",
          "description": "设备模型名称"
        },
        "deviceCategoryId": {
          "type": [ "integer", "null" ],
          "description": "设备类别在数据库中的ID；尚未选择类别的预览允许为null"
        }
      },
      "required": [ "deviceModelId", "deviceModelName", "deviceCategoryId" ]
    },
    "attributes": {
      "type": "array",
      "description": "设备属性空间",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "属性唯一标识名"
          },
          "displayName": {
            "type": "string",
            "description": "前端UI渲染显示名"
          },
          "valueKind": {
            "type": "string",
            "enum": [ "DISCRETE", "CONTINUOUS" ]
          },
          "dataType": {
            "$ref": "protocol-spec.json#/definitions/DataType"
          },
          "unit": {
            "type": "string",
            "description": "物理单位"
          }
        },
        "required": [ "name", "valueKind", "dataType" ]
      }
    },
    "capabilities": {
      "type": "array",
      "description": "设备对外暴露的操作能力",
      "items": {
        "type": "object",
        "properties": {
          "capabilityName": {
            "type": "string",
            "description": "操作能力唯一标识名"
          },
          "adapterCommandName": {
            "type": "string",
            "description": "映射并指向adapterContract.commands中的commandName"
          },
          "displayName": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "dataType": {
                  "$ref": "protocol-spec.json#/definitions/DataType"
                }
              },
              "required": [ "name", "displayName", "dataType" ]
            }
          },
          "parameterMapping": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "commandParamName": {
                  "type": "string"
                },
                "capabilityParamName": {
                  "type": "string"
                },
                "isFixedValue": {
                  "type": "boolean",
                  "default": false
                },
                "fixedValue": {}
              },
              "required": [ "commandParamName", "isFixedValue" ]
            }
          }
        },
        "required": [ "capabilityName", "adapterCommandName", "displayName", "parameters", "parameterMapping" ]
      }
    },
    "adapterContract": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "protocol": {
              "$ref": "protocol-spec.json#/definitions/CommunicationProtocol"
            },
            "adapterName": {
              "type": "string"
            },
            "categoryName": {
              "type": "string"
            }
          },
          "required": [ "protocol", "adapterName", "categoryName" ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "commandName": {
                "type": "string"
              },
              "commandParameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "paramName": {
                      "type": "string"
                    },
                    "dataType": {
                      "$ref": "protocol-spec.json#/definitions/DataType"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [ "paramName", "dataType" ]
                }
              }
            },
            "required": [ "commandName", "commandParameters" ]
          }
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "adapterAttributes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "dataType": {
                    "$ref": "protocol-spec.json#/definitions/DataType"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [ "name", "dataType" ]
              }
            },
            "attributesMapping": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "adapterAttrName": {
                    "type": "string"
                  },
                  "modelAttributeName": {
                    "type": "string"
                  }
                },
                "required": [ "adapterAttrName", "modelAttributeName" ]
              }
            }
          },
          "required": [ "adapterAttributes", "attributesMapping" ]
        },
        "events": {
          "type": "object",
          "properties": {
            "cmdEvents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "eventName": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [ "eventName", "description" ]
              }
            },
            "opEvents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "eventName": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [ "eventName", "description" ]
              }
            }
          },
          "required": [ "cmdEvents", "opEvents" ]
        }
      },
      "required": [ "config", "commands", "telemetry", "events" ]
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "portName": {
            "type": "string"
          },
          "direction": {
            "$ref": "protocol-spec.json#/definitions/InterfaceDirection"
          },
          "bindingAttrName": {
            "type": "string"
          }
        },
        "required": [ "portName", "direction", "bindingAttrName" ]
      }
    },
    "intrinsicConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectAttributeName": {
            "type": "string"
          },
          "operator": {
            "allOf": [
              {
                "$ref": "protocol-spec.json#/definitions/ConstraintOperator"
              },
              {
                "enum": [ ">", "<", ">=", "<=", "=", "!=" ]
              }
            ]
          },
          "boundaryValue": {
            "type": "number"
          },
          "violationStateName": {
            "type": "string"
          }
        },
        "required": [ "objectAttributeName", "operator", "boundaryValue", "violationStateName" ]
      }
    }
  },
  "required": [ "metadata", "attributes", "capabilities", "adapterContract", "ports", "intrinsicConstraints" ],
  "definitions": {}
}
