{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceStateMachineModel",
  "description": "设备状态机模型规范。设备专属状态和转移由本模型定义；标准CMD骨架由system-execution-spec.json注入。",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "deviceModelId": {
          "type": [ "integer", "null" ],
          "description": "所属设备模型在数据库中的ID；新建模型预览时允许为null"
        }
      },
      "required": [ "deviceModelId" ]
    },
    "interfaces": {
      "type": "array",
      "description": "设备专属状态机接口声明列表；不得覆盖系统标准接口。",
      "items": {
        "$ref": "#/definitions/interface"
      }
    },
    "opStateSpace": {
      "type": "object",
      "properties": {
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "regionName": {
                "type": "string"
              },
              "initialStateName": {
                "type": "string"
              },
              "states": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/state"
                }
              }
            },
            "required": [ "regionName", "initialStateName", "states" ]
          }
        }
      },
      "required": [ "regions" ]
    },
    "cmdLifecycleSpace": {
      "type": "object",
      "description": "设备对标准CMD骨架的Adapter事件补充；状态名须符合system-execution-spec.json中的commandStateNames。",
      "properties": {
        "initialStateName": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/state"
          }
        }
      },
      "required": [ "initialStateName", "states" ]
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "stateSpace": {
            "type": "string",
            "enum": [ "CMD", "OP" ]
          },
          "regionName": {
            "type": "string",
            "description": "stateSpace为OP时必填"
          },
          "fromStateName": {
            "type": "string"
          },
          "toStateName": {
            "type": "string"
          },
          "trigger": {
            "$ref": "#/definitions/trigger"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/stateMachineAction"
            }
          }
        },
        "required": [ "stateSpace", "fromStateName", "toStateName", "trigger" ]
      }
    }
  },
  "required": [ "metadata", "interfaces", "opStateSpace", "cmdLifecycleSpace", "transitions" ],
  "definitions": {
    "interface": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "direction": {
          "$ref": "protocol-spec.json#/definitions/InterfaceDirection"
        },
        "interfaceType": {
          "$ref": "protocol-spec.json#/definitions/InterfaceType"
        },
        "allowedSignals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [ "name", "direction", "interfaceType", "allowedSignals" ]
    },
    "state": {
      "type": "object",
      "properties": {
        "stateName": {
          "type": "string"
        },
        "onEntry": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/stateMachineAction"
          }
        }
      },
      "required": [ "stateName" ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "interfaceName": {
          "type": "string"
        },
        "signalName": {
          "type": "string"
        }
      },
      "required": [ "interfaceName", "signalName" ]
    },
    "stateMachineAction": {
      "type": "object",
      "description": "状态机动作配置。当前内置SEND动作的运行语义由system-execution-spec.json定义。",
      "properties": {
        "actionName": {
          "type": "string",
          "enum": [ "SEND" ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "interfaceName": {
              "type": "string"
            },
            "signalName": {
              "type": "string"
            },
            "value": {}
          },
          "required": [ "interfaceName", "signalName" ]
        }
      },
      "required": [ "actionName", "payload" ]
    }
  }
}
